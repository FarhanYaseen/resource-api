{
    "info": {
      "name": "Task Management API",
      "description": "Collection for testing Task Management CRUD operations",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
      {
        "name": "Tasks",
        "item": [
          {
            "name": "Get All Tasks",
            "request": {
              "method": "GET",
              "header": [],
              "url": {
                "raw": "{{baseUrl}}/resource",
                "host": ["{{baseUrl}}"],
                "path": ["resource"]
              }
            }
          },
          {
            "name": "Create Task",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n    \"title\": \"Complete Project Documentation\",\n    \"description\": \"Write comprehensive documentation for the new features\",\n    \"completed\": false\n}"
              },
              "url": {
                "raw": "{{baseUrl}}/resource",
                "host": ["{{baseUrl}}"],
                "path": ["resource"]
              }
            }
          },
          {
            "name": "Get Task by ID",
            "request": {
              "method": "GET",
              "header": [],
              "url": {
                "raw": "{{baseUrl}}/resource/{{taskId}}",
                "host": ["{{baseUrl}}"],
                "path": ["resource", "{{taskId}}"]
              }
            }
          },
          {
            "name": "Update Task",
            "request": {
              "method": "PUT",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n    \"title\": \"Updated Task Title\",\n    \"description\": \"Updated task description\",\n    \"completed\": true\n}"
              },
              "url": {
                "raw": "{{baseUrl}}/resource/{{taskId}}",
                "host": ["{{baseUrl}}"],
                "path": ["resource", "{{taskId}}"]
              }
            }
          },
          {
            "name": "Delete Task",
            "request": {
              "method": "DELETE",
              "header": [],
              "url": {
                "raw": "{{baseUrl}}/resource/{{taskId}}",
                "host": ["{{baseUrl}}"],
                "path": ["resource", "{{taskId}}"]
              }
            }
          },
          {
            "name": "Patch Task",
            "request": {
              "method": "PATCH",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n    \"completed\": true\n}"
              },
              "url": {
                "raw": "{{baseUrl}}/resource/{{taskId}}",
                "host": ["{{baseUrl}}"],
                "path": ["resource", "{{taskId}}"]
              }
            }
          }
        ]
      }
    ],
    "variable": [
      {
        "key": "baseUrl",
        "value": "https://resource-api-seven.vercel.app"
      },
      {
        "key": "taskId",
        "value": "your-task-id-here"
      }
    ]
  }