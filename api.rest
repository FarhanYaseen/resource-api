@baseUrl = https://resource-api-seven.vercel.app
@taskId = your-task-id-here

### Get all tasks
GET {{baseUrl}}/resource

### Create task
POST {{baseUrl}}/resource
Content-Type: application/json

{
    "title": "Test Task",
    "description": "Test Description",
    "completed": false
}

### Get task by ID
GET {{baseUrl}}/resource/{{taskId}}

### Update task
PUT {{baseUrl}}/resource/{{taskId}}
Content-Type: application/json

{
    "title": "Updated Task",
    "description": "Updated Description",
    "completed": true
}

### Delete task
DELETE {{baseUrl}}/resource/{{taskId}}