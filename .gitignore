# Ignore node_modules
node_modules/

# Ignore build and output directories
dist/
build/
out/

# Ignore temporary files and logs
*.log
*.tmp

# Ignore TypeScript declaration files
dist/**/*.d.ts

# Ignore compiled JavaScript files
*.js
*.js.map

# Ignore environment files
.env
.env.local

# Ignore editor and system-specific files
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Ignore package manager lock files (optional, depending on your workflow)
# Uncomment if you use a specific package manager exclusively
# yarn.lock
# package-lock.json
# pnpm-lock.yaml

# Ignore test coverage reports
coverage/

# Ignore npm debug logs
npm-debug.log*

# Ignore eslint and prettier cache
.eslintcache
.prettiercache

# Ignore output from tsc
*.tsbuildinfo
