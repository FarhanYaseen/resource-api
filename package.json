  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "test": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "typeorm": "typeorm-ts-node-commonjs",
